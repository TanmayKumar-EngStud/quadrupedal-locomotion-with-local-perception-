{
  "env": {
    "num_envs": 4096, "backend": "warp", "device": "cuda:0", "seed": 0,
    "terrain_types": ["rough", "slope", "stairs_up", "stairs_down", "obstacles", "stepping_stones", "gaps", "piles"],
    "terrain_weights": [1, 1, 1, 1, 1, 1.2, 1, 4.8],
    "terrain_resolution": 0.05, "fine_terrain_resolution": 0.025, "terrain_levels": 10,
    "terrain_noise": 0.0, "terrain_noise_ramp": 0, "terrain_variants": 2, "pile_pit_ramp": false, "max_start_level": 9, "target_distance": [0.4, 3.0], "curriculum_rule": "relaxed",
    "rewards": {"arrival_speed": -10.0, "feet_in_gap": -20.0}
  },
  "updates": 100000, "max_hours": 2, "validation_seed": 100,
  "rollout_steps": 24, "epochs": 5, "minibatches": 4,
  "learning_rate": 0.001, "desired_kl": 0.01, "gamma": 0.99, "gae_lambda": 0.95,
  "entropy": 0.001, "hidden": [512, 256, 128],
  "checkpoint_every": 25, "evaluation_every": 25,
  "output": "runs/kth-variant-4-relaxed"
}
